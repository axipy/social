{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axipy.org/spec/v2/schemas/body-ready.schema.json",
  "type": "object",
  "properties": {
    "session": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "accepted_authorities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^axk1_[A-Za-z0-9_-]{43}$"
      }
    }
  },
  "required": [
    "session",
    "accepted_authorities"
  ],
  "additionalProperties": false
}
