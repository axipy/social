{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axipy.org/spec/v2/schemas/body-providers.schema.json",
  "type": "object",
  "properties": {
    "cid": {
      "type": "string",
      "pattern": "^b[a-z2-7]{58}$"
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "node-descriptor.schema.json"
      },
      "maxItems": 128
    }
  },
  "required": [
    "cid",
    "providers"
  ],
  "additionalProperties": false
}
