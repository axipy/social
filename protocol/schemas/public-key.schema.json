{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axipy.org/spec/v2/schemas/public-key.schema.json",
  "type": "object",
  "properties": {
    "kty": {
      "const": "OKP"
    },
    "crv": {
      "const": "Ed25519"
    },
    "x": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  },
  "required": [
    "kty",
    "crv",
    "x"
  ],
  "additionalProperties": false
}
