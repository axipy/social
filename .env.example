# Deploy social.axipy.org atrás de proxy HTTPS (Nginx/Caddy)
HOST=127.0.0.1
PORT=3000
# Porta de comunicação direta entre nós AXIPY Wire v2
PEER_HOST=0.0.0.0
PEER_PORT=4101
PUBLIC_PEER_HOST=social.axipy.org
# Endereço da AUTORIDADE, que NÃO é um nó AXIPY
CERT_URL=https://cert.axipy.org/v2/issue
# Nós iniciais: endereços TCP, não URLs HTTP
BOOTSTRAPS=
DATA_DIR=./var
# USE_PROXY_HEADERS=true apenas quando atrás de proxy HTTPS de confiança
USE_PROXY_HEADERS=false
# Opcional: durações de sessão em horas
SESSION_HOURS=12
